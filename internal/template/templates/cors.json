{
  "name": "cors",
  "description": "CORS Misconfiguration - API endpoints that may have CORS issues",
  "filetypes": [],
  "patterns": [
    "/api/",
    "/api/v1/",
    "/api/v2/",
    "/graphql",
    "/rest/",
    "/data/",
    "/ajax/",
    "/async/",
    "/webhook",
    "/callback",
    "/token",
    "/auth/",
    "/login",
    "/session",
    "/user/",
    "/users/",
    "/me",
    "/profile",
    "/account",
    "/settings",
    "/preferences",
    "/notifications",
    "/messages",
    "/inbox",
    "/dashboard",
    "/admin/",
    "/internal/",
    "/private/",
    "?origin=",
    "&origin=",
    "?cors=",
    "&cors=",
    "?callback=",
    "&callback=",
    "?jsonp=",
    "&jsonp=",
    "?_callback=",
    "&_callback=",
    ".json",
    ".jsonp",
    "format=json",
    "output=json",
    "csrf",
    "csrftoken",
    "csrf_token",
    "xsrf",
    "xsrftoken",
    "xsrf_token",
    "/widget",
    "/embed",
    "/iframe"
  ]
}
